# Caddy config for LT-HP production hosting.
#
# TLS certificate is issued and renewed automatically by rbg-cert (TUM CIT)
# from /var/lib/rbg-cert/live/. compose.prod.yaml bindmounts that directory
# read-only into the container at /etc/caddy/tls/.
#
# A renewal hook in /usr/local/cert.d/ reloads Caddy after rbg-cert refreshes
# the certificate, so no restart is required during normal operation.

{
	# Disable Caddy's automatic ACME flow — rbg-cert provides the cert.
	auto_https disable_certs
}

ltvm5.cit.tum.de {
	tls /etc/caddy/tls/fullchain.pem /etc/caddy/tls/privkey.pem

	root * /srv/site
	encode gzip zstd
	file_server

	handle_errors {
		@404 expression `{err.status_code} == 404`
		rewrite @404 /404.html
		file_server
	}
}
