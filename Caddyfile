# Caddy config for LT-HP production hosting.
#
# Both names are listed so Caddy auto-provisions a Let's Encrypt cert for each
# as soon as the DNS resolves to LT-HP (131.159.30.175). Until the friendlier
# legaltech.cit.tum.de record exists, only ltvm5.cit.tum.de will be issued.

ltvm5.cit.tum.de, legaltech.cit.tum.de {
	root * /srv/site
	encode gzip zstd
	file_server

	handle_errors {
		@404 expression `{err.status_code} == 404`
		rewrite @404 /404.html
		file_server
	}
}
